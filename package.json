{
  "name": "lichen-theme",
  "displayName": "Lichen",
  "description": "Dark theme with lichen greens on near-black blue",
  "version": "0.1.0",
  "publisher": "1hue",
  "author": {
    "name": "1hue",
    "url": "https://1hue.dev"
  },
  "license": "MIT",
  "type": "module",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#84DCC6",
    "theme": "dark"
  },
  "homepage": "https://github.com/1hue/lichen-vscode#readme",
  "bugs": {
    "url": "https://github.com/1hue/lichen-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1hue/lichen-vscode"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "green"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2"
  },
  "contributes": {
    "themes": [
      {
        "label": "Lichen",
        "uiTheme": "vs-dark",
        "path": "./build/lichen-color-theme.json"
      }
    ]
  },
  "generate": {
    "build/lichen-color-theme.json": {
      "name": "Lichen",
      "type": "dark",
      "semanticHighlighting": true,
      "colors": "#/workbench.colorCustomizations",
      "tokenColors": "#/editor.tokenColorCustomizations/textMateRules",
      "semanticTokenColors": "#/editor.semanticTokenColorCustomizations/rules"
    },
    ".vscode/colors.json": [
      "workbench.colorCustomizations",
      "editor.tokenColorCustomizations",
      "editor.semanticTokenColorCustomizations"
    ],
    ".vscode/layout.json": [
      "*",
      "!.vscode/colors.json",
      "!workbench.colorTheme"
    ]
  }
}