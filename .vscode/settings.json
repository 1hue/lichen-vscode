  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "variable": "#DAE0E5",
      "parameter": "#DAE0E5",
      "property": "#DAE0E5",
      "property.declaration": "#96FCE2",
      "enumMember": "#DAE0E5",
      "function": "#3FF3C6",
      "method": "#3FF3C6",
      "class": "#3FF3C6",
      "function.defaultLibrary": "#3FF3C6",
      "method.defaultLibrary": "#3FF3C6",
      "type": "#3FB5BB",
      "interface": "#3FB5BB",
      "typeParameter": "#3FB5BB",
      "enum": "#3FB5BB",
      "namespace": "#3FB5BB",
      "*.defaultLibrary": "#3FB5BB",
      "variable.defaultLibrary": "#42D5B1",
      "class.defaultLibrary": "#42D5B1",
      "property.defaultLibrary": "#DAE0E5"
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Punctuation and operators",
        "scope": [
          "punctuation",
          "keyword.operator",
          "meta.brace",
          "storage.type.function.arrow",
          "punctuation.definition.template-expression.begin",
          "punctuation.definition.template-expression.end",
          "punctuation.section.embedded",
          "punctuation.definition.string"
        ],
        "settings": {
          "foreground": "#2D5D7B"
        }
      },
      {
        "name": "Types",
        "scope": [
          "support.type",
          "entity.name.type",
          "markup.inline.raw",
          "markup.fenced_code",
          "markup.raw",
          "meta.diff",
          "meta.diff.header"
        ],
        "settings": {
          "foreground": "#3FB5BB"
        }
      },
      {
        "name": "Built-in objects and classes",
        "scope": [
          "support.class",
          "support.constant",
          "support.variable"
        ],
        "settings": {
          "foreground": "#42D5B1"
        }
      },
      {
        "name": "Property declarations",
        "scope": [
          "meta.object-literal.key",
          "support.type.property-name"
        ],
        "settings": {
          "foreground": "#96FCE2"
        }
      },
      {
        "name": "Variables, parameters and property references",
        "scope": [
          "variable",
          "variable.other.property",
          "variable.parameter",
          "variable.other.object",
          "entity.name.variable",
          "entity.name.tag",
          "entity.other.attribute-name",
          "markup.underline.link",
          "string.other.link",
          "markup.inserted"
        ],
        "settings": {
          "foreground": "#DAE0E5"
        }
      },
      {
        "name": "Function, method and class names",
        "scope": [
          "entity.name.function",
          "support.function",
          "variable.other.object.property",
          "variable.object.property",
          "entity.name.command",
          "entity.name.type.class",
          "entity.name.class",
          "entity.other.inherited-class",
          "markup.heading",
          "entity.name.section"
        ],
        "settings": {
          "foreground": "#42D5B1"
        }
      },
      {
        "name": "Language constructs like export, const, async, function and return",
        "scope": [
          "keyword",
          "keyword.control",
          "storage.type",
          "storage.modifier.async",
          "keyword.operator.new",
          "keyword.operator.expression",
          "keyword.other"
        ],
        "settings": {
          "foreground": "#C58EF1"
        }
      },
      {
        "name": "Modifiers like private, readonly, get and set",
        "scope": [
          "variable.language",
          "storage.modifier",
          "storage.type.property"
        ],
        "settings": {
          "foreground": "#3F98AA"
        }
      },
      {
        "name": "Errors and deletions",
        "scope": [
          "markup.deleted",
          "invalid",
          "log.error"
        ],
        "settings": {
          "foreground": "#EC41AD"
        }
      },
      {
        "name": "Strings and literal values",
        "scope": [
          "string",
          "string.regexp",
          "constant.numeric",
          "constant.language",
          "constant.character",
          "constant.other.color",
          "markup.changed",
          "log.warning"
        ],
        "settings": {
          "foreground": "#C2E6A1"
        }
      },
      {
        "name": "Regex anchors, sets and groups",
        "scope": [
          "keyword.control.anchor.regexp",
          "punctuation.character.set.begin.regexp",
          "punctuation.character.set.end.regexp",
          "punctuation.definition.group.regexp",
          "punctuation.definition.group.assertion.regexp",
          "punctuation.definition.character-class.regexp",
          "keyword.operator.or.regexp",
          "keyword.operator.negation.regexp"
        ],
        "settings": {
          "foreground": "#EDB6A3"
        }
      },
      {
        "name": "Regex classes, quantifiers and escapes",
        "scope": [
          "constant.character.character-class.regexp",
          "constant.other.character-class.set.regexp",
          "constant.other.character-class.range.regexp",
          "constant.character.set.regexp",
          "constant.character.escape.backslash.regexp",
          "keyword.operator.quantifier.regexp",
          "constant.character.escape"
        ],
        "settings": {
          "foreground": "#E0F2D0"
        }
      },
      {
        "name": "Comments",
        "scope": [
          "comment",
          "punctuation.definition.comment",
          "string.quoted.docstring",
          "storage.type.class.jsdoc",
          "variable.other.jsdoc",
          "entity.name.type.instance.jsdoc",
          "punctuation.definition.block.tag.jsdoc",
          "punctuation.definition.bracket.curly.begin.jsdoc",
          "punctuation.definition.bracket.curly.end.jsdoc",
          "keyword.codetag.notation"
        ],
        "settings": {
          "foreground": "#2D5D7B"
        }
      },
      {
        "name": "Markup styles",
        "scope": [
          "markup.bold",
          "markup.heading"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markup italic",
        "scope": [
          "markup.italic",
          "markup.quote"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "workbench.editor.decorations.colors": false,
  "workbench.experimental.modernUIEditorTabStyle": "pill",
  "workbench.experimental.modernUIUppercaseViewHeaders": true,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.indent": 20,
  "workbench.tree.renderIndentGuides": "always",
  "breadcrumbs.enabled": false,
  // "editor.folding": false,
  "editor.fontFamily": "'JetBrains Mono', 'Google Sans Code', monospace",
  "editor.fontSize": 12.5,
  "editor.formatOnSave": true,
  "editor.glyphMargin": false,
  "editor.matchBrackets": "never",
  "editor.renderLineHighlight": "none",
  "editor.stickyScroll.enabled": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.decorations.colors": false,
  "window.zoomLevel": 0.2
}